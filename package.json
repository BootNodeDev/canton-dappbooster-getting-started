{
  "name": "canton-dappbooster-getting-started",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3012 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build-dar": "node scripts/fetch-daml-deps.mjs && node scripts/build-dar.mjs",
    "deploy-dar": "bash scripts/deploy-dar.sh",
    "stack": "bash scripts/dev-stack.sh",
    "mint-token": "node scripts/mint-token.mjs ledger-api-user",
    "wallet-gateway": "mkdir -p .wallet-gateway && wallet-gateway -c ./wallet-gateway.config.json"
  },
  "dependencies": {
    "@bootnodedev/canton-connect": "^0.6.0",
    "@bootnodedev/canton-dappbooster": "^0.6.0",
    "@bootnodedev/canton-theme": "^0.6.0",
    "@canton-network/core-types": "^1.8.0",
    "@canton-network/dapp-sdk": "1.5.1",
    "@walletconnect/sign-client": "^2.23.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@bootnodedev/canton-barebones": "0.6.0",
    "@canton-network/wallet-gateway-remote": "1.11.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
