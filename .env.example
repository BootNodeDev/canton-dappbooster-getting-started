# Offers a "Mock Wallet" in the wallet picker so the app connects with no wallet reachable.
# Unset it, or set it to anything but `true`, once you have a real wallet to connect.
VITE_MOCK_WALLET=true

# Lists a Wallet Gateway (https://github.com/canton-network/wallet) in the picker. A session
# survives a reload only for a gateway listed here.
# VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp

###############################################################################
# Participant (pnpm deploy-dar)
###############################################################################
CANTON_JSON_API_URL=http://localhost:2975
# The token `deploy-dar` sends: a JWT your participant accepts. On a LocalNet, `pnpm stack up` or `pnpm mint-token` makes one.
CANTON_BACKEND_TOKEN=

###############################################################################
# LocalNet token recipe (pnpm mint-token, run by `pnpm stack up`)
###############################################################################
CANTON_AUTH_AUDIENCE=https://canton.network.global
# Never copy CANTON_AUTH_SECRET into a browser.
CANTON_AUTH_SECRET=unsafe

###############################################################################
# Wallet Gateway (pnpm wallet-gateway, or started by `pnpm stack up`)
###############################################################################
VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp
